{
  "name": "tscute",
  "version": "0.6.0",
  "description": "A way to execute/import TypeScript",
  "type": "module",
  "bin": {
    "tscute": "build/bin/tscute.js"
  },
  "main": "build/loader-register.js",
  "exports": {
    ".": "./build/loader-register.js",
    "./*.js": "./build/*.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "start": "node build/bin/tscute.js"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "get-tsconfig": "^4.14.3",
    "oxc-resolver": "^11.8.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@startracex/dev-config": "^0.7.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "typescript",
    "execute"
  ],
  "author": "startracex",
  "license": "MIT",
  "files": [
    "**/*.{d.ts,js}+(|.map)",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startracex/tscute.git"
  },
  "packageManager": "pnpm@12.16.1"
}
